<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">

    <Properties>
        <Property name="agent-name">$${spring:agent.name:-snap}</Property>
        <Property name="agent-id">$${spring:agent.id:-${hostName}}</Property>
        <Property name="file-path">$${spring:logging.file.path:-log}</Property>
    </Properties>

    <Appenders>
        <Console name="console" >
            <!-- phone번호 mask 처리 %m -> %mask -->
            <PatternLayout disableAnsi="false" pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %highlight{%-5level}{FATAL=red blink, ERROR=red, WARN=yellow bold, INFO=green, DEBUG=green bold, TRACE=blue} [%style{%-20.-20logger{1}}{cyan}] : %mask %n%wEx"/>
        </Console>

        <RollingFile name="fileAppender"
                     fileName="${file-path}/${agent-name}_${agent-id}.log"
                     filePattern="${file-path}/%d{yyyyMMdd}/${agent-name}_${agent-id}_%i.log"
                     immediateFlush="false"
                     append="true">
            <!-- phone번호 mask 처리 %m -> %mask -->
            <PatternLayout pattern="%d{HH:mm:ss,SSS} %-5level [%-20.-20logger{1}] : %mask %n%wEx"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy fileIndex="max" max="30" compressionLevel="0"/>
        </RollingFile>
        <RollingFile name="scheduleFileAppender"
                     fileName="${file-path}/${agent-name}_${agent-id}_schedule.log"
                     filePattern="${file-path}/%d{yyyyMMdd}/${agent-name}_${agent-id}_%i_schedule.log"
                     immediateFlush="false"
                     append="true">
            <!-- phone번호 mask 처리 %m -> %mask -->
            <PatternLayout pattern="%d{HH:mm:ss,SSS} %-5level [%-20.-20logger{1}] : %mask %n%wEx"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy fileIndex="max" max="30" compressionLevel="0"/>
        </RollingFile>

        <Async name="asyncFileAppender" includeLocation="false">
            <AppenderRef ref="fileAppender"/>
        </Async>
    </Appenders>

    <Loggers>
        <Root level="info">
<!--            <AppenderRef ref="console"/>-->
            <AppenderRef ref="asyncFileAppender"/>
        </Root>

        <Logger name="kr.co.uplus.agent.snap" level="info"/>
        <Logger name="kr.co.uplus.agent.snap.mapper" level="error"/>
        <Logger name="kr.co.uplus.agent.snap.core.schedule" level="info" additivity="false">
<!--            <AppenderRef ref="console"/>-->
            <AppenderRef ref="scheduleFileAppender"/>
        </Logger>

        <Logger name="org.springframework" level="error"/>
        <Logger name="org.springframework.transaction" level="error"/>
        <Logger name="org.springframework.web.reactive" level="error"/>

        <Logger name="reactor" level="error"/>
        <Logger name="reactor.netty.http.client" level="error"/>
        <Logger name="io.netty" level="error"/>

        <Logger name="org.apache" level="error"/>

        <Logger name="org.hibernate.validator" level="error"/>

        <Logger name="com.zaxxer.hikari" level="off"/>

        <Logger name="jdbc" level="off" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="jdbc.connection" level="off"/>
        <Logger name="jdbc.sqlonly" level="off"/>
        <Logger name="jdbc.sqltiming" level="off"/>
        <Logger name="jdbc.audit" level="off"/>
        <Logger name="jdbc.resultset" level="off"/>
        <Logger name="jdbc.resultsettable" level="off"/>
    </Loggers>
</Configuration>